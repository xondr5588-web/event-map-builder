{
  "name": "event-map-builder",
  "version": "1.1.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-sw.mjs",
    "build:pages": "vite build --mode public && node scripts/build-sw.mjs --protected",
    "build:private": "vite build --mode private && node scripts/build-sw.mjs --protected",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:access": "playwright test --config playwright.access.config.js",
    "check": "npm test && npm run build && npm run test:e2e",
    "format": "prettier --write src tests server scripts index.html *.js *.json .github/workflows/*.yml README.md docs/*.md"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.6.2",
    "vite": "8.3.1"
  }
}
